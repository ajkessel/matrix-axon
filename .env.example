# Copy to .env and adjust. .env is gitignored.
#
# These configure the local docker-compose Postgres and the connection
# string the app uses to reach it. The defaults are fine for local dev;
# change the password for any non-local deployment.

POSTGRES_USER=axon
POSTGRES_PASSWORD=axon
POSTGRES_DB=axon

# Host port the docker-compose Postgres binds to. Change this if 5432 is
# already taken by a local Postgres (e.g. Homebrew/Postgres.app on macOS),
# and update the port in DATABASE_URL to match.
POSTGRES_PORT=5432

# Connection string for axon-server. Loaded automatically from .env at startup.
DATABASE_URL=postgres://axon:axon@127.0.0.1:5432/axon

# --- Sync engine (optional) ------------------------------------------------
# The server boots without these; omit them to run with no sync / no accounts.

# Symmetric key for encrypting account access tokens at rest and passphrasing
# the matrix-rust-sdk store. Required once an account is configured. Maps onto
# sync.store_key. Choose a strong random value; keep it stable — changing it
# invalidates existing encrypted tokens and SDK stores.
AXON_SYNC__STORE_KEY=change-me

# A single account can also be provisioned entirely via env (maps onto
# [sync.account] in axon.toml). Supply exactly one of password / access_token.
AXON_SYNC__ACCOUNT__USER_ID=@alice:example.org
AXON_SYNC__ACCOUNT__HOMESERVER_URL=https://matrix.example.org
AXON_SYNC__ACCOUNT__PASSWORD=hunter2

# Secure Backup / 4S recovery key (optional). Consumed once on boot to import
# the megolm key backup + cross-signing keys so a fresh device can decrypt
# historical messages; never persisted. Maps onto sync.account.recovery_key.
# AXON_SYNC__ACCOUNT__RECOVERY_KEY=EsTc ...
