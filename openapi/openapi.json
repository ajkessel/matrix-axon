        }
      },
      "delete": {
        "tags": [
          "messages"
        ],
        "summary": "Redact an event, optionally with a reason (`?reason=`).",
        "operationId": "redact_event",
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "description": "Axon account id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "room_id",
            "in": "path",
            "description": "Matrix room id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "event_id",
            "in": "path",
