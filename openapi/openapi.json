    "/v1/accounts/{account_id}/rooms/{room_id}/timeline": {
      "get": {
        "tags": [
          "rooms"
        ],
        "summary": "Read a room's timeline, newest first, with cursor pagination.",
        "description": "An unknown `account_id`/`room_id` yields an empty page (200), not a 404 — an\nempty timeline and a non-existent room are indistinguishable here and an\nempty page is the natural answer.",
        "operationId": "room_timeline",
        "parameters": [
          {
            "name": "account_id",
            "in": "path",
            "description": "Axon account id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "room_id",
            "in": "path",
            "description": "Matrix room id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque cursor from a previous page's `next_cursor`; omit for the newest page.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Page size (default 50, max 200).",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of timeline events",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse_TimelinePage"
                }
              }
            }
          },
          "400": {
            "description": "Malformed cursor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/rooms": {
      "get": {
        "tags": [
          "rooms"
        ],
        "summary": "List rooms across accounts, most-recent-activity first.",
        "operationId": "list_rooms",
        "parameters": [
          {
            "name": "account_id",
            "in": "query",
            "description": "Narrow the list to a single account. Omit for all accounts.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Rooms, newest activity first",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse_Vec_RoomDto"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountDto": {
        "type": "object",
        "description": "An account in the lifecycle read API (`GET /v1/accounts`,\n`GET /v1/accounts/{account_id}`). The encrypted access token is deliberately\nabsent — only public lifecycle facts are exposed, never a secret.",
        "required": [
          "account_id",
          "user_id",
          "homeserver_url",
          "state",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "account_id": {
            "type": "string",
            "format": "uuid",
            "description": "Stable Axon account id."
          },
          "created_at": {
            "type": "string",
            "description": "Row creation time, RFC 3339."
          },
          "device_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Device ID of axon's current session, once it has logged in."
          },
          "homeserver_url": {
            "type": "string",
            "description": "Homeserver base URL."
          },
          "state": {
            "$ref": "#/components/schemas/AccountStateDto",
            "description": "Lifecycle state. The list endpoint returns only `active` accounts; a by-id\nread can return any state."
          },
          "updated_at": {
            "type": "string",
            "description": "Last update time, RFC 3339."
          },
          "user_id": {
            "type": "string",
            "description": "Full Matrix user ID, e.g. `@alice:example.org`."
          },
          "verified": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Whether axon's own device is currently cross-signed (orthogonal to\n`state`). `null` until the derivation lands (a later subphase) — a real\n`false` would wrongly read as \"known unverified\", so we expose \"unknown\"\nas absence rather than a misleading boolean."
          }
        }
      },
      "AccountStateDto": {
        "type": "string",
        "description": "Lifecycle state on the wire — the constrained enum form of\n[`axon_store::AccountState`], so the OpenAPI schema advertises the closed set\n(`active` / `deactivated` / `deleting`) and generated clients can model it\nexhaustively rather than seeing an open `string`. Serialize-only: unknown\n*stored* values are still rejected at the store boundary\n(`AccountState::from_db`), so widening the wire vocabulary can't smuggle one in.",
        "enum": [
          "active",
          "deactivated",
          "deleting"
        ]
      },
      "ApiResponse_AccountDto": {
        "type": "object",
        "description": "Success envelope: a 2xx body is always `{ \"data\": <T> }`.",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "description": "An account in the lifecycle read API (`GET /v1/accounts`,\n`GET /v1/accounts/{account_id}`). The encrypted access token is deliberately\nabsent — only public lifecycle facts are exposed, never a secret.",
            "required": [
              "account_id",
              "user_id",
              "homeserver_url",
              "state",
              "created_at",
              "updated_at"
            ],
            "properties": {
              "account_id": {
                "type": "string",
                "format": "uuid",
                "description": "Stable Axon account id."
              },
              "created_at": {
                "type": "string",
                "description": "Row creation time, RFC 3339."
              },
              "device_id": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Device ID of axon's current session, once it has logged in."
              },
              "homeserver_url": {
                "type": "string",
                "description": "Homeserver base URL."
              },
              "state": {
                "$ref": "#/components/schemas/AccountStateDto",
                "description": "Lifecycle state. The list endpoint returns only `active` accounts; a by-id\nread can return any state."
              },
              "updated_at": {
                "type": "string",
                "description": "Last update time, RFC 3339."
              },
              "user_id": {
                "type": "string",
                "description": "Full Matrix user ID, e.g. `@alice:example.org`."
              },
              "verified": {
                "type": [
                  "boolean",
                  "null"
                ],
                "description": "Whether axon's own device is currently cross-signed (orthogonal to\n`state`). `null` until the derivation lands (a later subphase) — a real\n`false` would wrongly read as \"known unverified\", so we expose \"unknown\"\nas absence rather than a misleading boolean."
              }
            }
          }
        }
      },
      "ApiResponse_EventDto": {
        "type": "object",
        "description": "Success envelope: a 2xx body is always `{ \"data\": <T> }`.",
        "required": [
          "data"
        ],
